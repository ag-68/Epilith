# Required by SEC EDGAR. Must identify the caller and include a mailbox SEC can write to.
# A no-reply address (for example @users.noreply.github.com) is blocked as "undeclared automated tool".
# Example: Epilith/0.1 (research; you@example.com)
SEC_USER_AGENT=

# Optional overrides. Yahoo is the price cross-check; Stooq is the primary quote.
YAHOO_USER_AGENT=Epilith/0.1

# Experiment 0b. Model provider key; see config/llm.yaml for which models are called.
GROQ_API_KEY=
